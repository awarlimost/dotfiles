{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/assets/meguminfastfetch-transparent.png",
        "width": 14,
        "height": 14,
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " : ",
        "color": {
            "keys": "38;2;255;180;162",
            "title": "38;2;241;223;218"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        "separator",
        { "type": "os", "key": " OS" },
        { "type": "kernel", "key": "󰕚 Kernel" },
        { "type": "uptime", "key": "󰔟 Uptime" },
        { "type": "shell", "key": "󰞷 Shell" },
        { "type": "wm", "key": "󰧨 WM" },
        { "type": "terminal", "key": "󰆍 Terminal" },
        "break",
        { "type": "cpu", "key": "󰘚 CPU" },
        { "type": "memory", "key": "󰍛 Memory" },
        { "type": "disk", "key": "󰋊 Disk" },
        { "type": "packages", "key": "󰏓 Packages" }
    ]
}
